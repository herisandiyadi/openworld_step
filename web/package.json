{
  "name": "openworld-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "assets": "vite-node tools/assets/build.ts",
    "world": "vite-node tools/world/build.ts",
    "content:check": "vite-node tools/content/check.ts",
    "content:pack": "vite-node tools/content/pack.ts",
    "test:content": "vitest run src/content src/content-runtime",
    "test": "vitest run",
    "cap:sync": "cap sync android",
    "android:debug": "npm run build && cap sync android && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/network": "7.0.4",
    "@capacitor/preferences": "7.0.4",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recast-navigation": "0.43.1",
    "three": "0.186.1",
    "zod": "3.25.67",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-node": "3.2.4",
    "vitest": "3.2.7"
  }
}
