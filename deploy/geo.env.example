# OpenWorld City — geo service env
# Copy ke /etc/openworld/geo.env dan isi nilai sebenarnya. JANGAN commit file ini.

# Port & host
GEO_PORT=19100
GEO_HOST=127.0.0.1
DASH_PORT=19101
DASH_HOST=127.0.0.1
GEO_GENERATOR_URL=http://127.0.0.1:19100

# Cache OSM + job history
GEO_CACHE=/root/workspace/geo-map-pipeline/services/geo-generator/cache

# Admin token (SHA-256 hex dari bearer token). Digenerate: sha256sum <<< "$TOKEN"
GEO_ADMIN_TOKEN_SHA256=REPLACE_WITH_SHA256_OF_ADMIN_TOKEN

# Dashboard perlu token mentah untuk proxy ke generator
GEO_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN

# Map pack signing (Ed25519). Private key multiline atau pakai file.
MAP_PACK_KEY_ID=map-pack-1
MAP_PACK_PRIVATE_KEY_FILE=/etc/openworld/map-pack-private.pem