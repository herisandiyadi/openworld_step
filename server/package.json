{
  "name": "mp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server multiplayer internet (M3) untuk game open-world: WebSocket authoritative, room in-memory, AOI 50 pemain.",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "loadtest": "node loadtest/bots.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
